# ============================================================
# Coop-CBM 实验路径配置
# 修改此文件中的路径后无需改动任何代码
# ============================================================

# -------- 数据集路径 --------
# CUB-200-2011 鸟类数据集（主要数据集）
CUB_DATA_DIR=/media/pang/U/master_project/Datasets/CUB_200_2011

# AwA2 动物数据集
AWA2_DATA_DIR=src/data/AwA2

# TIL 肿瘤浸润淋巴细胞数据集
TIL_DATA_DIR=src/data/TIL

# 动物数据集（DatasetAnimals）
ANIMALS_DATA_DIR=src/data/animals

# CelebA 人脸数据集
CELEBA_DATA_DIR=src/data/CelebA

# OOD 鸟类数据集（分布外测试）
OOD_BIRD_DATA_DIR=src/data/OOD_birds

# -------- 输出路径 --------
OUTPUT_DIR=outputfiles

# -------- 数据集基础路径（BASE_DIR，旧版代码兼容） --------
# 留空表示使用项目根目录作为基础路径
BASE_DIR=

# -------- CUB 数据集参数 --------
N_ATTRIBUTES=312
N_CLASSES=200
